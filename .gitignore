# Drift-Sense .gitignore
# ============================================================
# dataset/ and eval_results/ ARE tracked (not ignored). The problem
# statement's checklist requires the manifest, results, plots, and
# failure-case visualization to actually be present in the submission,
# not just regeneratable by running scripts. Size is small (tens of MB
# for 40 grayscale 1000x1000 pairs), so there's no real cost to
# including them, and it removes any risk of a judge's environment not
# reproducing byte-identical images from the same seed.

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.ipynb_checkpoints/

# --- OS/editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Local scratch only -- never real submission content ---
smoketest/
dummy_v2/
dummy_eval_out/
eval_results_v1data/
eval_results_v2/

# --- Extra/experimental dataset variants beyond the submission set --
# the canonical ./dataset folder stays tracked, these don't
dataset_hard/
dataset_v2*/
